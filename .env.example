# Flask session signing key.
# Generate a private value with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Replace this placeholder in your private .env; never use it in deployment.
SECRET_KEY=replace-with-a-private-random-secret

# Runtime roles:
# local_sensor: Windows/local capture, inference, and SQLite by default.
# hosted_web: hosted dashboard/API; requires PostgreSQL event + delivery backends,
#   DATABASE_URL, NETRA_AUTH_USERNAME, NETRA_AUTH_PASSWORD, and a sensor API key
#   of at least 32 characters.
# hosted_worker: separate shared PostgreSQL delivery-outbox worker.
# report_job: scheduled report process; requires PostgreSQL event storage and
#   PostgreSQL delivery storage for shared hosted reporting.
# Configure only the variables required by the role you run.
NETRA_RUNTIME_ROLE=local_sensor
NETRA_DELIVERY_BACKEND=sqlite
NETRA_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# Delivered-only audit cleanup is opt-in via prune_delivery_records(); zero disables it.
# Permanently failed records are always retained for operator action.
NETRA_DELIVERY_AUDIT_RETENTION_DAYS=3650

# V2 dashboard/API protection. Leave empty for loopback-only local development.
# Both values are required for remote access; use a long unique password and HTTPS.
NETRA_AUTH_USERNAME=
NETRA_AUTH_PASSWORD=

# Merge duplicate ML alerts for the same source/destination/ports/protocol/label.
# Set to 0 to disable aggregation.
NETRA_ALERT_COOLDOWN_SECONDS=60

# Optional Resend notification for entry into a critical live-capture incident.
# Email delivery is disabled unless explicitly enabled and all settings are valid.
NETRA_EMAIL_ALERTS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
NETRA_EMAIL_TIMEOUT_SECONDS=5
NETRA_EMAIL_MAX_ATTEMPTS=4
# Local SQLite override. Empty shares the local sensor event SQLite database.
# Set NETRA_DELIVERY_BACKEND=postgresql on the sensor to write into shared storage.
NETRA_EMAIL_ALERT_DB_PATH=

# Optional weekly stored-activity report. Scheduler is external; target is
# Monday 09:00 Asia/Kolkata (03:30 UTC). No scheduler is created by NETRA.
NETRA_WEEKLY_REPORT_ENABLED=false
NETRA_WEEKLY_REPORT_TO_EMAIL=
# Local SQLite override; empty shares the local critical-email delivery database.
NETRA_WEEKLY_REPORT_DB_PATH=

# Critical live-session policy: enter at 10 ATTACK labels in 20 flow
# classifications; recover at 4 or fewer. Recovery sends no email.
NETRA_CRITICAL_WINDOW=20
NETRA_CRITICAL_ATTACKS=10
NETRA_CRITICAL_RECOVERY_ATTACKS=4

# Local V2 event history. Relative paths resolve from the project root.
NETRA_EVENT_BACKEND=sqlite
NETRA_EVENT_DB_PATH=data/netra_events.sqlite3
NETRA_EVENT_RETENTION_DAYS=30

# Sensor ingestion authentication and optional local-sensor forwarding.
# hosted_web requires NETRA_SENSOR_API_KEY with at least 32 characters.
# For sensor forwarding, use the same strong key on sensor and hosted web.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep forwarding disabled until the hosted ingestion endpoint is configured.
NETRA_SENSOR_API_KEY=
NETRA_FORWARDING_ENABLED=false
NETRA_INGESTION_URL=
NETRA_FORWARD_TIMEOUT_SECONDS=5
NETRA_FORWARD_BATCH_SIZE=100
NETRA_FORWARD_OUTBOX_MAX_EVENTS=10000

# PostgreSQL connection string.
# Required when the selected runtime uses PostgreSQL; leave empty for local SQLite.
# Set this privately in the hosting provider's environment configuration.
# Never commit a real URL or database password.
DATABASE_URL=

# Model & Data Paths (relative to project root)
MODEL_PATH=results/models/lightgbm_top20_model.pkl
DATASET_PATH=data/processed/Friday-WorkingHours-Morning.pcap_ISCX.csv

# Local development server configuration.
# Hosted deployment binds to the platform-provided PORT.
HOST=127.0.0.1

# Server Port Options (Default: 5000)
# Alternative ports if port 5000 is occupied:
# PORT=5001
# PORT=8000
# PORT=8080
# PORT=3000
PORT=5000

# Quick Run Commands:
# .\.venv\Scripts\python.exe app/app.py
# Open: http://127.0.0.1:5000
